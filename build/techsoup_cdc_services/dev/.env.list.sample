# Copy to .env.list and fill values. Used by dev/compose.yaml.

# --- Secrets ---
ADMIN_SECRET=
DC_API_KEY=
DC_NL_API_KEY=
GEMINI_API_KEY=
MAPS_API_KEY=
# Flask secret for JWT cookie. Empty = random key per process.
SECRET_KEY=

# --- App ---
FLASK_ENV=techsoup
IS_CUSTOM_DC=true
ENABLE_ADMIN=true
ENABLE_MODEL=true
ENABLE_MCP=false
#ENABLE_DATAGEMMA=true
#MCP_SSE_URL=
#GENAI_MODEL=gemini-2.5-flash

# --- Data ---
OUTPUT_DIR=/userdata
USE_SQLITE=true
TOKENIZERS_PARALLELISM=false

# --- Newsletter (Google Form) ---
# Form 'formResponse' URL.
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/<form-id>/formResponse
# Map of app fields to form entry IDs.
FORM_FIELD_MAPPING_JSON={"first_name": "entry.<id>", "last_name": "entry.<id>", "email": "entry.<id>", "organization": "entry.<id>", "is_active": "entry.<id>"}
# Hosts allowed to get newsletter token. Comma list or ['a', 'b'].
TRUSTED_DOMAINS=['localhost:8080']
